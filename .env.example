# Application Configuration
APP_NAME=eastwater-backend
APP_ENV=development
PORT=8080

# Third-Party External API Configuration
# Set USE_MOCK_3RDPARTY=true to run offline with simulated mock responses
USE_MOCK_3RDPARTY=true
THIRD_PARTY_BASE_URL=https://api.thirdparty.example.com
THIRD_PARTY_API_KEY=your_third_party_api_key_here
THIRD_PARTY_SECRET=your_third_party_secret_here
THIRD_PARTY_TIMEOUT_SECONDS=30
THIRD_PARTY_DEBUG=true

# Client API Authentication (Leave empty to allow open access)
API_KEY=
